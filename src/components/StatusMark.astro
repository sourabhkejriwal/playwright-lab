---
// Test-reporter style status glyph: ✓ passed or read, ● ready, ◌ pending, ✗ failed, – skipped.
export type Status = 'passed' | 'read' | 'ready' | 'pending' | 'failed' | 'skipped';
interface Props {
  status: Status;
  label?: boolean;
}
const { status, label = false } = Astro.props;
const glyph = { passed: '✓', read: '✓', ready: '●', pending: '◌', failed: '✗', skipped: '–' }[status];
const color = {
  passed: 'text-pass',
  read: 'text-pass',
  ready: 'text-info',
  pending: 'text-pending',
  failed: 'text-fail',
  skipped: 'text-dim',
}[status];
---

<span class={color} data-status={status}>
  <span aria-hidden="true">{glyph}</span>
  {label ? ` ${status}` : <span class="sr-only">{status}</span>}
</span>
