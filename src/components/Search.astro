---
// The site search dialog, opened by the top bar's button or by Cmd/Ctrl+K. The index is built by Pagefind
// after `astro build` and only downloaded when a visitor first opens the dialog.
import Kbd from './Kbd.astro';
---

<dialog
  data-search-dialog
  aria-label="search"
  class="mx-auto mt-[10dvh] max-h-[80dvh] w-[calc(100%-2rem)] max-w-xl flex-col overflow-hidden rounded-term border border-line-strong bg-surface p-0 text-text open:flex backdrop:bg-bg/80"
>
  <div class="flex items-center gap-3 border-b border-line px-4 py-3">
    <span class="text-pass" aria-hidden="true">
      $
    </span>
    <input
      data-search-input
      type="text"
      role="combobox"
      aria-label="search notes and tools"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="search-results"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="grep the notes and tools"
      class="min-w-0 flex-1 bg-transparent text-base text-bright outline-none placeholder:text-dim"
    />
    <button
      type="button"
      data-search-close
      aria-label="close search"
      class="cursor-pointer rounded-term text-sm text-muted hover:text-bright"
    >
      esc
    </button>
  </div>

  <div
    id="search-results"
    role="listbox"
    aria-label="search results"
    hidden
    class="min-h-0 flex-1 overflow-y-auto overscroll-contain"
  ></div>

  <p data-search-status role="status" class="px-4 py-3 text-sm text-muted"></p>

  <p class="hidden gap-4 border-t border-line px-4 py-2 text-xs text-dim sm:flex" aria-hidden="true">
    <span>
      <Kbd>↑</Kbd> <Kbd>↓</Kbd> move
    </span>
    <span>
      <Kbd>↵</Kbd> open
    </span>
    <span>
      <Kbd>esc</Kbd> close
    </span>
  </p>
</dialog>

<script>
  import { url } from '../lib/url';
  import { MAX_PAGES, excerptParts, toHits, type Pagefind, type SearchHit } from '../lib/search';

  const IDLE_MESSAGE = 'type to search the notes and tools';
  const OPTION_CLASS =
    'block border-b border-line px-4 py-3 no-underline last:border-b-0 hover:bg-raised aria-selected:bg-raised';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLElement>('#search-results')!;
  const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
  const closeButton = dialog.querySelector<HTMLButtonElement>('[data-search-close]')!;
  const openButton = document.querySelector<HTMLButtonElement>('[data-search-open]')!;

  // On a Mac, Ctrl+K belongs to text fields: it deletes to the end of the line, also in the playground editor.
  const isMac = /mac/i.test(navigator.platform);

  let index: Promise<Pagefind> | null = null;
  let latestSearch = 0;
  let activeOption = -1;

  function loadIndex(): Promise<Pagefind> {
    index ??= (import(/* @vite-ignore */ url('pagefind/pagefind.js')) as Promise<Pagefind>)
      .then(async (pagefind) => {
        await pagefind.options({ baseUrl: url() });
        await pagefind.init();
        return pagefind;
      })
      .catch((error: unknown) => {
        index = null; // Let the next search try again.
        throw error;
      });
    return index;
  }

  function options(): HTMLElement[] {
    return [...list.querySelectorAll<HTMLElement>('[role="option"]')];
  }

  function setActive(position: number) {
    activeOption = position;
    options().forEach((option, i) => {
      const active = i === position;
      option.setAttribute('aria-selected', String(active));
      if (active) {
        input.setAttribute('aria-activedescendant', option.id);
        option.scrollIntoView({ block: 'nearest' });
      }
    });
    if (position < 0) input.removeAttribute('aria-activedescendant');
  }

  function renderOption(hit: SearchHit, position: number): HTMLAnchorElement {
    const option = document.createElement('a');
    option.id = `search-option-${position}`;
    option.href = hit.href;
    option.setAttribute('role', 'option');
    option.tabIndex = -1;
    option.className = OPTION_CLASS;

    const heading = document.createElement('span');
    heading.className = 'block text-sm text-bright';
    heading.textContent = hit.page;
    if (hit.section) {
      const section = document.createElement('span');
      section.className = 'text-muted';
      section.textContent = ` › ${hit.section}`;
      heading.append(section);
    }

    const excerpt = document.createElement('span');
    excerpt.className = 'mt-1 block font-prose text-sm text-muted';
    for (const part of excerptParts(hit.excerpt)) {
      if (part.match) {
        const mark = document.createElement('mark');
        mark.className = 'bg-transparent font-semibold text-pass';
        mark.textContent = part.text;
        excerpt.append(mark);
      } else {
        excerpt.append(part.text);
      }
    }

    option.append(heading, excerpt);
    return option;
  }

  function showHits(hits: SearchHit[], message: string) {
    list.replaceChildren(...hits.map(renderOption));
    list.hidden = hits.length === 0;
    input.setAttribute('aria-expanded', String(hits.length > 0));
    setActive(hits.length > 0 ? 0 : -1);
    status.textContent = message;
  }

  async function runSearch() {
    const query = input.value.trim();
    const search = ++latestSearch;
    if (!query) {
      showHits([], IDLE_MESSAGE);
      return;
    }
    try {
      const pagefind = await loadIndex();
      const found = await pagefind.debouncedSearch(query, {}, 120);
      if (!found || search !== latestSearch) return;
      const pages = await Promise.all(found.results.slice(0, MAX_PAGES).map((result) => result.data()));
      if (search !== latestSearch) return;
      const hits = toHits(pages);
      const count = hits.length === 1 ? '1 result' : `${hits.length} results`;
      showHits(hits, hits.length > 0 ? count : `no results for "${query}"`);
    } catch {
      if (search === latestSearch) showHits([], "search isn't available right now");
    }
  }

  function openSearch() {
    latestSearch++;
    input.value = '';
    showHits([], IDLE_MESSAGE);
    dialog.showModal();
    input.focus();
    loadIndex().catch(() => {
      // Reported when the visitor searches, and tried again then.
    });
  }

  input.addEventListener('input', runSearch);

  input.addEventListener('keydown', (event) => {
    if (event.isComposing) return;
    const count = options().length;
    if (event.key === 'ArrowDown' && count > 0) {
      event.preventDefault();
      setActive((activeOption + 1) % count);
    } else if (event.key === 'ArrowUp' && count > 0) {
      event.preventDefault();
      setActive((activeOption - 1 + count) % count);
    } else if (event.key === 'Enter' && activeOption >= 0) {
      event.preventDefault();
      options()[activeOption].click();
    }
  });

  list.addEventListener('click', (event) => {
    const openedElsewhere = event.metaKey || event.ctrlKey || event.shiftKey;
    // A result on the current page only moves to a heading, so the dialog has to close itself.
    if (!openedElsewhere && (event.target as Element).closest('[role="option"]')) dialog.close();
  });

  // The dialog's content fills its box, so a click landing on the dialog itself is on the backdrop.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  closeButton.addEventListener('click', () => dialog.close());
  openButton.addEventListener('click', openSearch);

  window.addEventListener('keydown', (event) => {
    const shortcut = event.metaKey || (event.ctrlKey && !isMac);
    if (!shortcut || event.altKey || event.shiftKey || event.key.toLowerCase() !== 'k') return;
    event.preventDefault();
    if (dialog.open) dialog.close();
    else openSearch();
  });

  // Coming back to a page from the back/forward cache shouldn't reopen the search.
  window.addEventListener('pagehide', () => dialog.close());

  if (isMac) {
    openButton.setAttribute('aria-keyshortcuts', 'Meta+K');
    openButton.querySelector('kbd')!.textContent = '⌘K';
  }
  // The button stays hidden until it works.
  openButton.dataset.ready = '';
</script>
