---
// Homepage hero panel: overall progress as a Playwright run summary.
// One segment per chapter (green = notes written), plus a "next up" link.
// The full chapter list lives in the sidebar, so this stays compact.
import TerminalWindow from './TerminalWindow.astro';
import { url } from '../lib/url';
import { pad } from '../data/chapters';
import type { ChapterWithStatus } from '../lib/chapters';

interface Props {
  chapters: ChapterWithStatus[];
}
const { chapters } = Astro.props;
const passed = chapters.filter((c) => c.status === 'passed').length;
const pending = chapters.length - passed;
const next = chapters.find((c) => c.status === 'pending');
---

<TerminalWindow title="~/playwright-lab — npx playwright test">
  <p class="text-dim">
    <span class="text-pass">$</span> npx playwright test
  </p>
  <p class="mt-2 text-muted">Running {chapters.length} chapters using 1 learner</p>

  <ol class="mt-4 grid grid-cols-16 gap-1" aria-label="Chapter progress">
    {chapters.map((c, i) => (
      <li class="reveal" style={`animation-delay:${0.2 + i * 0.05}s`}>
        <a
          href={url(c.href)}
          title={`ch${pad(c.num)} ${c.short}: ${c.status}`}
          class:list={[
            'block h-6 rounded-sm no-underline transition-opacity hover:opacity-80',
            c.status === 'passed' ? 'bg-pass' : 'bg-line-strong',
          ]}
        >
          <span class="sr-only">
            Chapter {c.num}, {c.short}: {c.status}
          </span>
        </a>
      </li>
    ))}
  </ol>

  <p class="mt-4">
    <span class="text-pass">{passed} passed</span>
    {pending > 0 && <span class="ml-3 text-pending">{pending} pending</span>}
  </p>
  {next && (
    <p class="mt-3 border-t border-line pt-3 text-muted">
      next up ›{' '}
      <a href={url(next.href)} class="text-info">
        ch{pad(next.num)} {next.title}
      </a>
    </p>
  )}
</TerminalWindow>

<style>
  .reveal {
    opacity: 0;
    animation: reveal 0.25s ease-out forwards;
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: scaleY(0.4);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
