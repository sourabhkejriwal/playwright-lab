---
import { url } from '../lib/url';

const links = [
  { href: url('chapters'), label: 'chapters' },
  { href: url('playground'), label: 'playground' },
  { href: url('flashcards'), label: 'flashcards' },
  { href: url('about'), label: 'about' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/90 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 text-sm"
    aria-label="Main"
  >
    <a href={url()} class="font-semibold text-bright no-underline hover:text-pass">
      <span class="text-pass">$</span> playwright-lab
      <span class="text-pass motion-safe:animate-pulse" aria-hidden="true">
        _
      </span>
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {links.map(({ href, label }) => {
        const active = current.startsWith(href.replace(/\/$/, ''));
        return (
          <li>
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={['no-underline', active ? 'text-pass' : 'text-muted hover:text-bright']}
            >
              {active ? `./${label}` : label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
