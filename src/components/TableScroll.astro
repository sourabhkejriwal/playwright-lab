---
// Replaces every Markdown table in a chapter (mapped as `table` in mdx.ts). The wrapper scrolls a
// wide table sideways on a phone instead of squeezing its columns, and is focusable so keyboard
// users can scroll it (axe's scrollable-region-focusable rule).
const props = Astro.props;
---

<div class="table-scroll" role="region" aria-label="Table" tabindex="0">
  <table {...props}>
    <slot />
  </table>
</div>
