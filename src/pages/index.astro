---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestRunHero from '../components/TestRunHero.astro';
import { getChapters } from '../lib/chapters';
import { url } from '../lib/url';

const chapters = await getChapters();

const tools = [
  {
    href: 'playground',
    cmd: 'locator --try',
    title: 'Locator playground',
    text: 'Type a locator, see what it matches on a live page.',
  },
  {
    href: 'flashcards',
    cmd: 'drill --cards',
    title: 'Flashcards',
    text: 'Interview-style questions with spaced repetition.',
  },
  {
    href: 'chapters',
    cmd: 'ls chapters/',
    title: 'Chapter notes',
    text: '16 chapters, from setup to a real e-commerce suite.',
  },
];
---

<BaseLayout title="playwright-lab">
  <section class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
    <div class="lg:pt-8">
      <p class="text-sm text-dim"># interactive study notes</p>
      <h1 class="mt-3 text-3xl font-semibold leading-tight text-bright sm:text-4xl">
        Learn Playwright by <span class="text-pass">running it</span>.
      </h1>
      <p class="mt-5 max-w-prose font-prose text-lg leading-relaxed text-muted">
        Chapter notes, a locator playground, and drills for end-to-end testing with Playwright, from first
        test to CI, accessibility, visual regression, and beyond.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <a
          href={url('chapters')}
          class="rounded-term bg-pass px-4 py-2 font-semibold text-bg no-underline hover:brightness-110"
        >
          start reading →
        </a>
        <a
          href={url('playground')}
          class="rounded-term border border-line-strong px-4 py-2 text-text no-underline hover:border-pass hover:text-bright"
        >
          try the playground
        </a>
      </div>
    </div>
    <TestRunHero chapters={chapters} />
  </section>

  <section class="mt-20" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="text-sm text-dim">
      # tools
    </h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      {tools.map((t) => (
        <li>
          <a
            href={url(t.href)}
            class="block h-full rounded-term border border-line bg-surface p-5 no-underline transition-colors hover:border-pass"
          >
            <p class="text-xs text-dim">
              <span class="text-pass">$</span> {t.cmd}
            </p>
            <h3 class="mt-3 font-semibold text-bright">{t.title}</h3>
            <p class="mt-2 font-prose text-sm text-muted">{t.text}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
