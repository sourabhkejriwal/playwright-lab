---
import BaseLayout from '../layouts/BaseLayout.astro';
import CiBuilder from '../islands/CiBuilder';
import { url } from '../lib/url';
---

<BaseLayout
  title="ci pipeline builder"
  description="Pick triggers, browsers, shards and report settings, and get a ready-to-use GitHub Actions workflow for Playwright."
>
  <p class="text-sm text-dim">
    <span class="text-pass">$</span> ci --build
  </p>
  <h1 class="mt-3 text-2xl font-semibold text-bright">CI pipeline builder</h1>
  <p class="mt-3 max-w-prose font-prose text-lg text-muted">
    Pick your triggers, browsers and shards, then save the finished workflow as{' '}
    <code class="font-mono text-base">.github/workflows/playwright.yml</code>. Browser names must match the
    projects in your config, which the{' '}
    <a href={url('config')} class="underline">
      config generator
    </a>{' '}
    sets up for you.
  </p>
  <noscript>
    <p class="mt-6 text-sm text-pending">The builder runs in your browser, so it needs JavaScript.</p>
  </noscript>
  <CiBuilder client:visible />
</BaseLayout>
