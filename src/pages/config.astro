---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConfigGenerator from '../islands/ConfigGenerator';
---

<BaseLayout
  title="config generator"
  description="Pick browsers, devices, retries, reporters and tracing, and get a ready-to-use playwright.config.ts."
>
  <p class="text-sm text-dim">
    <span class="text-pass">$</span> config --generate
  </p>
  <h1 class="mt-3 text-2xl font-semibold text-bright">Config generator</h1>
  <p class="mt-3 max-w-prose font-prose text-lg text-muted">
    Pick your browsers, devices, retries, reporters and tracing, then copy the finished{' '}
    <code class="font-mono text-base">playwright.config.ts</code> into your project.
  </p>
  <noscript>
    <p class="mt-6 text-sm text-pending">The generator runs in your browser, so it needs JavaScript.</p>
  </noscript>
  <ConfigGenerator client:visible />
</BaseLayout>
