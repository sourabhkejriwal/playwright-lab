---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { getChapters } from '../lib/chapters';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Open Graph type: "article" for written chapter notes. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search results (and drop its canonical link). */
  noindex?: boolean;
}
const {
  title,
  description = 'Interactive study notes, playgrounds, and drills for Playwright test automation.',
  ogType = 'website',
  noindex = false,
} = Astro.props;
const fullTitle = title === 'playwright-lab' ? title : `${title} · playwright-lab`;
// Trailing slash to match the sitemap and the URLs GitHub Pages serves.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const ogImage = new URL(url('og-image.png'), Astro.site).href;
const ogImageAlt = 'playwright-lab: learn Playwright by running it.';
const chapters = await getChapters();
const currentChapter = chapters.find(
  (c) => url(c.href).replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, ''),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Inline and render-blocking so a saved light theme never flashes dark first. -->
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('playwright-lab:theme') === 'light') theme = 'light';
        } catch {
          // Storage can be blocked: keep the default theme.
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="playwright-lab" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} sizes="any" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:bg-raised focus:px-3 focus:py-1"
    >
      skip to content
    </a>
    <TopBar />

    <!-- Two columns from lg up: sticky chapter sidebar + content. Below lg the sidebar becomes a drawer. -->
    <div class="mx-auto w-full max-w-7xl flex-1 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
      <aside class="hidden border-r border-line lg:block">
        <div class="sticky top-(--header-h) max-h-[calc(100dvh-var(--header-h))] overflow-y-auto px-3 py-8">
          <Sidebar chapters={chapters} />
        </div>
      </aside>

      <div class="flex min-w-0 flex-col">
        <details class="group mx-4 mt-4 rounded-term border border-line bg-surface lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm text-text [&::-webkit-details-marker]:hidden">
            <span>
              <span class="text-pass">☰</span> browse chapters
              {currentChapter && <span class="text-dim"> · {currentChapter.short}</span>}
            </span>
            <span class="text-dim transition-transform group-open:rotate-90" aria-hidden="true">
              ›
            </span>
          </summary>
          <div class="border-t border-line px-2 py-4">
            <Sidebar chapters={chapters} />
          </div>
        </details>

        <main id="main" class="w-full flex-1 px-4 pt-8 sm:px-8 lg:px-12 lg:pt-12">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
