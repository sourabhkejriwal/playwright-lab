---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Interactive study notes, playgrounds, and drills for Playwright test automation.',
} = Astro.props;
const fullTitle = title === 'playwright-lab' ? title : `${title} · playwright-lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:bg-raised focus:px-3 focus:py-1"
    >
      skip to content
    </a>
    <TopBar />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 pt-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
